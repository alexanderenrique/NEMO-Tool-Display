# NEMO Tool Display — run main.py under systemd so it survives SSH disconnect and
# restarts automatically after crashes.
#
# Install (Linux VM, no path edits in this file):
#   cd /path/to/vm_server
#   sudo ln -sf "$PWD/systemd/run-nemo-vm-server.sh" /etc/systemd/system/nemo-vm-server-exec.sh
#   sudo ln -sf "$PWD/systemd/nemo-vm-server.service" /etc/systemd/system/nemo-vm-server.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now nemo-vm-server.service
#
# If the exec script lives outside the repo tree, set: Environment=NEMO_VM_SERVER_DIR=/path/to/vm_server
#
# Stop / start:
#   sudo systemctl stop nemo-vm-server.service
#   sudo systemctl start nemo-vm-server.service
#
# Logs: journalctl -u nemo-vm-server.service -f
#       plus nemo_server.log under vm_server (Python logging uses cwd).

[Unit]
Description=NEMO Tool Display VM server (main.py)
After=network-online.target nemo-mosquitto.service
Wants=network-online.target
Requires=nemo-mosquitto.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# If you see status=217/USER, User=/Group= referred to a missing account — fix or leave commented for root.
# User=ubuntu
# Group=ubuntu
ExecStart=/etc/systemd/system/nemo-vm-server-exec.sh
Restart=on-failure
RestartSec=5

# If you need the process up even when it exits with code 0 (discouraged — fix exit codes instead):
# Restart=always

[Install]
WantedBy=multi-user.target
