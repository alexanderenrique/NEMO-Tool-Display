# NEMO Tool Display — Mosquitto using this repo's mqtt/config/mosquitto.conf
# Run in foreground (no -d) so systemd supervises the process.
#
# Install: same steps as nemo-vm-server.service (copy, edit ONE path below, daemon-reload, enable --now).
#
# Why cd + relative -c: mqtt/config/mosquitto.conf uses paths relative to vm_server (mqtt/data, mqtt/log, etc.).
# User=/Group=: optional. Omit both (as below) to run as root for a quick setup; set to your deploy user in production.

[Unit]
Description=NEMO Mosquitto (custom config in vm_server)
Documentation=https://mosquitto.org/man/mosquitto-8.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NEMO_VM_SERVER_DIR=CHANGE_ME_VM_SERVER_DIR
# Foreground mode — do not pass -d
ExecStart=/bin/sh -c 'cd "${NEMO_VM_SERVER_DIR}" && exec /usr/sbin/mosquitto -c mqtt/config/mosquitto.conf'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
