# NEMO Tool Display — Mosquitto using this repo's mqtt/config/mosquitto.conf
# Run in foreground (no -d) so systemd supervises the process.
#
# Install (no path edits in this file): symlink the runner script, then this unit, from your checkout.
#   cd /path/to/vm_server
#   sudo ln -sf "$PWD/systemd/run-nemo-mosquitto.sh" /etc/systemd/system/nemo-mosquitto-exec.sh
#   sudo ln -sf "$PWD/systemd/nemo-mosquitto.service" /etc/systemd/system/nemo-mosquitto.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now nemo-mosquitto.service
#
# The script finds vm_server from its real path (repo may be named NEMO-Tool-Display or anything).
# User=/Group=: optional — add under [Service] for non-root.
# Overrides: Environment=MOSQUITTO_BIN=…   or   Environment=NEMO_VM_SERVER_DIR=/path/to/vm_server (if exec script is not under vm_server/systemd/)

[Unit]
Description=NEMO Mosquitto (custom config in vm_server)
Documentation=https://mosquitto.org/man/mosquitto-8.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Foreground mode — do not pass -d
ExecStart=/etc/systemd/system/nemo-mosquitto-exec.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
