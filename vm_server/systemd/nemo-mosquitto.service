# NEMO Tool Display — Mosquitto using vm_server/mqtt/config/mosquitto.conf
# Run in foreground (no -d) so systemd supervises the process.
#
# 1. Edit NEMO_VM_SERVER_DIR and MOSQUITTO_BIN below if needed (find mosquitto: command -v mosquitto).
# 2. Install the unit and reload:
#      sudo cp /path/to/vm_server/systemd/nemo-mosquitto.service /etc/systemd/system/
#      sudo systemctl daemon-reload && sudo systemctl enable --now nemo-mosquitto.service
#
# User=/Group=: optional — add under [Service] for non-root.
# Requires mqtt/config/mosquitto.conf (gitignored until setup).

[Unit]
Description=NEMO Mosquitto (custom config in vm_server)
Documentation=https://mosquitto.org/man/mosquitto-8.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NEMO_VM_SERVER_DIR=/opt/NEMO-Tool-Display/vm_server
Environment=MOSQUITTO_BIN=/usr/sbin/mosquitto
WorkingDirectory=${NEMO_VM_SERVER_DIR}
ExecStart=${MOSQUITTO_BIN} -c ${NEMO_VM_SERVER_DIR}/mqtt/config/mosquitto.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
