# =============================================================================
# vm-server/config.env — SINGLE SOURCE OF TRUTH for the VM MQTT bridge + NEMO API polling
#
# Copy to config.env beside main.py (do not maintain vm-server/.env — see legacy note in main.py).
# =============================================================================

# MQTT Configuration
# MQTT broker for receiving tool status from NEMO backend and distributing to ESP32 displays
MQTT_BROKER=localhost
MQTT_PORT=1886

# Display Configuration
# Timezone offset in hours from UTC (e.g., -7 for Pacific Time, -5 for Eastern Time)
TIMEZONE_OFFSET_HOURS=-7

# Maximum character length for user names on display (truncate if longer)
MAX_NAME_LENGTH=14

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG


MQTT_PORT_ESP32=1883
MQTT_HMAC_KEY=your_hmac_key_here
MQTT_ALLOW_ANONYMOUS=false
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# -----------------------------------------------------------------------------
# NEMO HTTPS API (reservations + lab member directory; optional — omit NEMO_API_TOKEN to disable)
# -----------------------------------------------------------------------------
NEMO_API_BASE_URL=https://nemo.stanford.edu/api
# Django-style token auth is common (REST token from NEMO; not the MQTT HMAC secret):
NEMO_API_TOKEN=
# Alias accepted by main.py and test_reservations_live.py if NEMO_API_TOKEN is unset:
# NEMO_TOKEN=
NEMO_API_AUTH_SCHEME=Token

# Poll reservations and publish PREFIX/<tool_id>/next_reservation (retained JSON) only for tool IDs in the allowlist file.
NEMO_RESERVATIONS_POLL_SECONDS=900
# Optional: path to allowlist YAML/CSV relative to vm-server/ or absolute. Default mqtt_reservation_tools.yaml.
MQTT_RESERVATION_TOOLS_FILE=
# Copy mqtt_reservation_tools.example.yaml → mqtt_reservation_tools.yaml (gitignored); list tool_ids: [161, …] under that key or mqtt_tools / tools.
# Only consider reservations starting within this many days from now (empty-state wording uses this X).
NEMO_RESERVATIONS_LOOKAHEAD_DAYS=7